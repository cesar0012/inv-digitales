{
  "id": "otro",
  "label": "Otro evento",
  "description": "Graduación, aniversario, reunión u otra celebración.",
  "aliases": [
    "otro",
    "evento",
    "graduacion",
    "graduación",
    "aniversario",
    "reunion",
    "reunión"
  ],
  "honorees": 1,
  "sections": [
    {
      "id": "festejado",
      "title": "Festejado(a)",
      "fields": [
        {
          "key": "nombre",
          "label": "Nombre del anfitrión o del evento",
          "type": "text",
          "required": true,
          "placeholder": "Nombre y apellidos"
        }
      ]
    },
    {
      "ref": "fecha"
    },
    {
      "ref": "padres",
      "title": "Anfitriones"
    },
    {
      "ref": "ubicaciones"
    },
    {
      "ref": "itinerario"
    },
    {
      "ref": "vestimenta"
    },
    {
      "ref": "regalos"
    },
    {
      "ref": "confirmacion"
    },
    {
      "ref": "mensaje"
    }
  ],
  "modules": [
    {
      "type": "portada",
      "when": "always"
    },
    {
      "type": "countdown",
      "when": "data:fecha"
    },
    {
      "type": "padres",
      "when": "data:padres"
    },
    {
      "type": "ubicacion",
      "when": "data:ubicaciones",
      "repeatPer": "ubicaciones"
    },
    {
      "type": "itinerario",
      "when": "data:itinerario"
    },
    {
      "type": "vestimenta",
      "when": "data:codigo_vestimenta"
    },
    {
      "type": "regalos",
      "when": "data:regalos"
    },
    {
      "type": "galeria",
      "when": "flag:incluir_galeria"
    },
    {
      "type": "confirmacion",
      "when": "rsvp"
    }
  ],
  "labels": {
    "parentRole": "{Rol}",
    "parentRoleMemoriam": "En memoria de {rol}",
    "parentGroupBoth": "Papás",
    "padrinoRole": "Padrinos de {rol}",
    "honorSuffix": "",
    "rsvpInfo": "Si estás invitado, recibirás por WhatsApp, SMS o correo un enlace personal para confirmar tu asistencia.",
    "rsvpDeadline": "Confirma antes del {fecha}",
    "portadaFrase": "Te invitamos"
  },
  "copy": {
    "padres": {
      "padres-titulo": "Te invitan"
    }
  }
}
# Plantilla de variables de entorno — producción (Coolify)
# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

NODE_ENV=production
PORT=3001
VITE_PUBLIC_URL=https://generador.invitacionesmodernas.com
PUBLIC_URL=https://generador.invitacionesmodernas.com
VITE_API_BASE_URL=https://api.invitacionesmodernas.com/api

# Llaves de IA (también configurables desde el panel admin: html_google_api_key, image_api_key)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Token estático para la API de servicio (Laravel consulta datos de usuarios).
# Debe coincidir con INVITACIONES_SERVICE_TOKEN en Laravel. Genera uno largo y aleatorio.
API_SERVICE_TOKEN=

# OBLIGATORIO: secreto para firmar las sesiones del editor (mínimo 32 caracteres aleatorios).
# Sin él, el servidor genera uno aleatorio en cada arranque y las sesiones se cierran al reiniciar.
EDITOR_HMAC_SECRET=
TOKEN_TTL_DAYS=7

# Primer administrador del panel (solo se usa si todavía no existe ningún admin,
# o para reemplazar una contraseña por defecto antigua). Usa una contraseña fuerte.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Rutas de depuración (/api/debug/*): apagadas por defecto; aun encendidas requieren sesión de admin.
ENABLE_DEBUG_ROUTES=false

# Solo desarrollo: crea un usuario local de prueba (nunca en producción).
SEED_TEST_USERS=false
TEST_USER_EMAIL=test@invitacionesmodernas.com
TEST_USER_PASSWORD=

# Tiempo máximo de espera para llamadas a Laravel (ms).
LARAVEL_FETCH_TIMEOUT_MS=15000

# Proxies delante del servidor (Coolify/Traefik = 1). En producción el valor por
# defecto es 1; usa "false" solo si el servidor recibe tráfico directo.
TRUST_PROXY=1
